    "regex_scripts": [
        {
            "name": "Active mind note",
            "folder": "Notes",
            "find_regex": "\\(\\(OOC ",
            "flags": "g",
            "replace_string": "((OOC mind=\"{{getchatvar::mind}}\": ",
            "placement": [
                "ai_output"
            ],
            "target": [
                "display"
            ],
            "substitute_macros": "escaped",
            "actions": [],
            "scope": "global",
            "disabled": false,
            "run_on_edit": true,
            "min_depth": null,
            "max_depth": null,
            "sort_order": 0
        },
        {
            "name": "Old panels",
            "find_regex": "<panel>[\\s\\S]*?</panel>",
            "flags": "g",
            "replace_string": "",
            "placement": [
                "ai_output"
            ],
            "target": [
                "prompt"
            ],
            "substitute_macros": "none",
            "actions": [],
            "scope": "global",
            "disabled": false,
            "run_on_edit": true,
            "min_depth": 2,
            "max_depth": null,
            "sort_order": 1
        }
    ],
